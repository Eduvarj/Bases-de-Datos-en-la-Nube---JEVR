// Clase 7 de Octubre

use ("clientes")

db.clientes.insertOne(
    {
        _id: 1,
        nombre: 'Lopez Marcos',
        estado: 'Chihuahua',
    }
)
// Nos retorna un JSON informando el resultado de la inserción,
//mediantes un objeto con 2 campos el primero
//acknowledged, que indica que el documento fue admitido en la collección
//y el _id, que en este caso lo define el usuario de BD.
//
//Si se produce un error nos genera un objeto JSON con otra estuctura 
//errmsg, con un mensaje de error.

//otros comandos;

show dbs
local
config
clientes

use ("clientes")
show collections
clienteslibros

//Borrar bases de datos, colecciones a todos los documentos de una colección

use ("utt_libreria")
db.libros.deleteMany({})
show collections

